# ═══════════════════════════════════════════════════════════
# Signal Decay — Environment Variables
# Copy this to .env and fill in your values.
# ═══════════════════════════════════════════════════════════

# ─── Domain (required for Docker Compose / TLS) ───
DOMAIN=yourdomain.com

# ─── Server ───
WS_PORT=8080

# ─── Server Region (multi-server deployment) ───
REGION=local
SERVER_NAME=Local Dev

# ─── Game Configuration ───
MAX_CONCURRENT_SESSIONS=10
MIN_WORD_LENGTH=4
MAX_WORD_LENGTH=20
POINTS_PER_CORRECT=100
HINT_COST_POINTS=30
TURNS_PER_PLAYER=3
SESSION_DURATION_SEC=45

# ─── LLM Integration (optional — leave empty to use built-in word bank) ───
LLM_ENDPOINT=
LLM_API_KEY=

# ─── Client ───
# Single server mode (Docker Compose / dev):
VITE_WS_URL=ws://localhost:8080
#
# Multi-server mode (Fly.io + GitHub Pages):
# Leave VITE_WS_URL unset to enable server selection screen.
# Optionally override the server list:
# VITE_SERVERS=[{"id":"us","name":"US East","region":"Virginia","url":"wss://signal-decay-us.fly.dev","flag":"🇺🇸"}]
VITE_GOOGLE_CLIENT_ID=