# ═══════════════════════════════════════════════════════════
# Signal Decay — Environment Variables
# Copy this to .env and fill in your values.
# ═══════════════════════════════════════════════════════════

# ─── Domain (required for Docker Compose / TLS) ───
DOMAIN=yourdomain.com

# ─── Server ───
WS_PORT=8080

# ─── Server Region (multi-server deployment) ───
REGION=local
SERVER_NAME=Local Dev

# ─── Game Configuration ───
MAX_CONCURRENT_SESSIONS=10
MIN_WORD_LENGTH=4
MAX_WORD_LENGTH=20
POINTS_PER_CORRECT=100
HINT_COST_POINTS=30
TURNS_PER_PLAYER=3
SESSION_DURATION_SEC=45

# ─── Team Mode ───
# Length of the steal window after a failed attack, and the share of the
# round's points a successful steal is worth.
STEAL_SECONDS=15
STEAL_POINTS_PCT=60

# ─── Co-op Mode ───
# Lives per run, and the base for the shared guess pool
# (pool = COOP_GUESSES_BASE + player count).
COOP_LIVES=3
COOP_GUESSES_BASE=3

# ─── Solo Mode ───
# Display name for the bot rival, and the ceiling on one whole bot turn.
# The budget covers every guess in the turn, so the rival never eats the
# round clock the player is scored against.
BOT_NAME=CIPHER
BOT_TURN_BUDGET_MS=3000

# ─── LLM Integration (optional — leave empty to use built-in word bank) ───
LLM_ENDPOINT=
LLM_API_KEY=

# ─── Client ───
# Single server mode (Docker Compose / dev):
VITE_WS_URL=ws://localhost:8080
#
# Multi-server mode (Fly.io + GitHub Pages):
# Leave VITE_WS_URL unset to enable server selection screen.
# Optionally override the server list:
# VITE_SERVERS=[{"id":"us","name":"US East","region":"Virginia","url":"wss://signal-decay-us.fly.dev","flag":"🇺🇸"}]

# ─── Google Drive pack sync (optional, OFF by default) ───
# Set to true (or 1) to expose the Drive sync UI. Any other value keeps it off.
# Requires VITE_GOOGLE_CLIENT_ID as well.
VITE_ENABLE_GOOGLE_DRIVE=false
VITE_GOOGLE_CLIENT_ID=
