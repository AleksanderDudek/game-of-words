# Local secrets — copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
# Paths can be relative to the project root or absolute.

ANDROID_KEYSTORE_PATH=android/app/signal-decay.jks
ANDROID_KEYSTORE_PASSWORD=yourpassword
ANDROID_KEY_ALIAS=signal-decay
ANDROID_KEY_PASSWORD=yourkeypassword
