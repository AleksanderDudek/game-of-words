# Local secrets — copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

ANDROID_KEYSTORE_PATH=           # absolute path, e.g. /Users/you/project/android/app/signal-decay.jks
ANDROID_KEYSTORE_PASSWORD=       # password chosen during keytool -genkey
ANDROID_KEY_ALIAS=signal-decay
ANDROID_KEY_PASSWORD=            # key password chosen during keytool -genkey
