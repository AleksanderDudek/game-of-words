FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.client.json vite.config.ts index.html ./
COPY src/client/ src/client/
COPY src/shared/ src/shared/
COPY src/vite-env.d.ts src/
COPY public/ public/ 2>/dev/null || true
ARG VITE_WS_URL=ws://localhost:8080
ENV VITE_WS_URL=$VITE_WS_URL
# Google Drive pack sync — off unless explicitly enabled at build time
ARG VITE_ENABLE_GOOGLE_DRIVE=false
ENV VITE_ENABLE_GOOGLE_DRIVE=$VITE_ENABLE_GOOGLE_DRIVE
ARG VITE_GOOGLE_CLIENT_ID=
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
RUN npx vite build

FROM nginx:alpine
COPY --from=build /app/dist/client /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
